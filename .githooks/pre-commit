#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
if [ -x .venv/Scripts/python.exe ]; then
    exec .venv/Scripts/python.exe scripts/check_public_files.py --staged
elif [ -x .venv/bin/python ]; then
    exec .venv/bin/python scripts/check_public_files.py --staged
elif command -v python3 >/dev/null 2>&1; then
    exec python3 scripts/check_public_files.py --staged
else
    exec python scripts/check_public_files.py --staged
fi
